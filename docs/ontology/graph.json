  "constraints": [
    {
      "id": "R1",
      "statement": "Agent 成功、测试通过、已暂存均不能推导人工 reviewed。",
      "evidence": [
        "CONTEXT.md"
      ]
    },
    {
      "id": "R2",
      "statement": "只改变暂存位置不使人工结论失效；双侧内容变化使已有结论派生 recheck。",
      "evidence": [
        "src/main/services/review-store.ts"
      ]
    },
    {
      "id": "R3",
      "statement": "无具体问题只适用于 succeeded 且范围覆盖完整、报告有效、findings 为空的任务；不代表所有风险已排除。",
      "evidence": [
        "CONTEXT.md",
        "src/main/agents/report.ts"
      ]
    },
    {
      "id": "R4",
      "statement": "旧意见需按当前内容判定 stale，禁止直接采纳；历史 run 不覆盖。stale 采纳闭环仍属 BR-005。",
      "evidence": [
        "docs/CONTRACTS.md",
        "docs/BACKLOG.md"
      ]
    },
    {
      "id": "R5",
      "statement": "保存结论或草稿先校验快照指纹与磁盘内容身份；失败返回 content_changed，不能套用到新内容。",
      "evidence": [
        "src/main/services/review-service.ts"
      ]
    },
    {
      "id": "R6",
      "statement": "issue 有输入证据支持；verify 需外部依据。二者都不是人的审查结论。",
      "evidence": [
        "CONTEXT.md",
        "src/main/agents/report.ts"
      ]
    },
    {
      "id": "R7",
      "statement": "快照读取不一致重试，耗尽返回 snapshot_changed；不可审阅文件保留明确原因。",
      "evidence": [
        "src/main/services/snapshots.ts"
      ]
    },
    {
      "id": "R8",
      "statement": "取消及退出清理自己创建的 CLI 进程树；重启遗留任务为 interrupted，不自动重跑。",
      "evidence": [
        "src/main/services/review-runs.ts",
        "src/main/agents/runner.ts"
      ]
    },
    {
      "id": "R9",
      "statement": "Agent Review 不写用户仓库；Git 写入只能由明确产品操作触发。",
      "evidence": [
        "AGENTS.md",
        "docs/ARCHITECTURE.md"
      ]
    }
  ]
