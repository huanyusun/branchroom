  "nodes": [
    {
      "id": "Repository",
      "label": "仓库工作区",
      "kind": "concept",
      "status": "implemented",
      "definition": "用户打开的本地 Git 工作区；linked worktree 按根目录隔离",
      "sources": [
        "src/shared/contracts.ts",
        "src/main/services/repositories.ts"
      ]
    },
    {
      "id": "ReviewScope",
      "label": "审查范围",
      "kind": "concept",
      "status": "specified",
      "definition": "HEAD 到当前工作区；包括已暂存、未暂存及未跟踪内容",
      "sources": [
        "CONTEXT.md",
        "docs/PRD.md"
      ]
    },
    {
      "id": "Snapshot",
      "label": "冻结快照",
      "kind": "concept",
      "status": "implemented",
      "definition": "一次一致读取的 HEAD 与变更文件集合；不是提交",
      "sources": [
        "src/shared/contracts.ts",
        "src/main/services/snapshots.ts"
      ]
    },
    {
      "id": "ChangeFile",
      "label": "快照文件变更",
      "kind": "concept",
      "status": "implemented",
      "definition": "快照中的文件版本，带路径、双侧内容、Git 状态及可审阅原因",
      "sources": [
        "src/shared/contracts.ts",
        "src/main/services/snapshots.ts"
      ]
    },
    {
      "id": "Fingerprint",
      "label": "快照内容指纹",
      "kind": "concept",
      "status": "implemented",
      "definition": "SHA-256 绑定 repoId、HEAD、路径及基线/当前内容摘要；不含暂存状态",
      "sources": [
        "src/main/services/snapshots.ts"
      ]
    },
    {
      "id": "ContentIdentity",
      "label": "人工审查内容身份",
      "kind": "concept",
      "status": "implemented",
      "definition": "基线与当前内容的 SHA-256；仓库和路径由存储外层隔离",
      "sources": [
        "src/main/services/review-store.ts"
      ]
    },
    {
      "id": "HumanReview",
      "label": "人工审查结论",
      "kind": "concept",
      "status": "implemented",
      "definition": "人为保存 reviewed 或 issue；pending 为无记录，recheck 为内容不匹配派生态",
      "sources": [
        "src/main/services/review-store.ts",
        "src/shared/contracts.ts"
      ]
    },
    {
      "id": "FeedbackDraft",
      "label": "反馈草稿",
      "kind": "concept",
      "status": "implemented",
      "definition": "绑定文件内容身份的反馈文本；草稿保存与正式结论不同",
      "sources": [
        "src/main/services/review-service.ts",
        "src/shared/contracts.ts"
      ]
    },
    {
      "id": "ReviewRun",
      "label": "Agent 审查任务",
      "kind": "concept",
      "status": "implemented",
