        "meaning": ""
      }
    ],
    "dataProperties": [
      {
        "id": "root",
        "domain": [
          "Worktree"
        ],
        "datatype": "string",
        "meaning": "工作区路径是定位属性；当前实现也据此派生 ID。",
        "required": false
      },
      {
        "id": "headRef",
        "domain": [
          "Snapshot"
        ],
        "datatype": "string",
        "meaning": "捕获时的 HEAD；示例 unborn 明确表示无首个提交。",
        "required": true
      },
      {
        "id": "capturedAt",
        "domain": [
          "Snapshot"
        ],
        "datatype": "datetime",
        "meaning": "快照捕获时间。",
        "required": true
      },
      {
        "id": "path",
        "domain": [
          "FileObservation"
        ],
        "datatype": "string",
        "meaning": "仓库相对路径；不是全局文件身份。",
        "required": true
      },
      {
        "id": "side",
        "domain": [
          "FileObservation"
        ],
        "datatype": "string",
        "meaning": "观察所属的比较侧。",
        "required": true,
        "allowedValues": [
          "base",
          "current"
        ]
      },
      {
        "id": "contentKind",
        "domain": [
          "ContentValue"
        ],
        "datatype": "string",
        "meaning": "内容状态；不可读不等于不存在。",
        "required": true,
        "allowedValues": [
          "text",
          "absent",
          "unavailable"
        ]
      },
      {
        "id": "text",
        "domain": [
          "ContentValue"
        ],
        "datatype": "string",
        "meaning": "仅 contentKind=text 可有文本，包括空字符串。",
        "required": false
      },
      {
        "id": "reason",
        "domain": [
          "ContentValue"
        ],
        "datatype": "string",
        "meaning": "contentKind=unavailable 时的具体原因。",
        "required": false
      },
      {
        "id": "indexStatus",
        "domain": [
          "ChangeComparison"
        ],
        "datatype": "string",
        "meaning": "Git index 状态值，与人工结论独立。",
        "required": false
      },
      {
        "id": "worktreeStatus",
        "domain": [
          "ChangeComparison"
        ],
        "datatype": "string",
        "meaning": "Git 工作区状态值。",
        "required": false
      },
      {
        "id": "fingerprint",
        "domain": [
          "ChangeComparison"
        ],
        "datatype": "string",
        "meaning": "现实现包含工作区、HEAD、路径与内容摘要；仅是比较令牌。",
        "required": false
      },
      {
        "id": "contentIdentity",
        "domain": [
          "ChangeComparison"
        ],
        "datatype": "string",
        "meaning": "现实现的双侧内容摘要；不构成跨仓库实体身份。",
        "required": false
      },
      {
        "id": "judgment",
        "domain": [
          "HumanJudgment"
        ],
        "datatype": "string",
        "meaning": "人工判断内容；pending 与 recheck 不属于已表达判断。",
        "required": true,
        "allowedValues": [
          "reviewed",
          "issue"
        ]
      },
      {
        "id": "runStatus",
        "domain": [
          "AgentReviewRun"
        ],
        "datatype": "string",
        "meaning": "运行生命周期状态。",
        "required": true,
        "allowedValues": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled",
          "interrupted"
        ]
      },
      {
        "id": "kind",
        "domain": [
          "Finding"
        ],
        "datatype": "string",
        "meaning": "断言的证据要求分类，不能据此推出断言为真。",
        "required": true,
        "allowedValues": [
          "issue",
          "verify"
        ]
      },
      {
        "id": "claim",
        "domain": [
          "Finding"
        ],
        "datatype": "string",
        "meaning": "可被质疑、核实的问题命题。",
        "required": true
      },
      {
        "id": "locationSide",
        "domain": [
          "Finding"
        ],
        "datatype": "string",
        "meaning": "定位侧，与行范围及目标比较共同解释。",
        "required": true,
        "allowedValues": [
          "base",
          "current"
        ]
      },
      {
        "id": "startLine",
        "domain": [
          "Finding"
        ],
        "datatype": "integer",
        "meaning": "从 1 开始的行号。",
        "required": true
      },
      {
        "id": "endLine",
        "domain": [
          "Finding"
        ],
        "datatype": "integer",
        "meaning": "不小于 startLine。",
        "required": true
      },
      {
        "id": "disposition",
        "domain": [
          "Finding"
        ],
        "datatype": "string",
        "meaning": "人的处理决定，不等于问题真假或已经修复。",
        "required": false,
        "allowedValues": [
          "open",
          "accepted",
          "dismissed"
        ]
      },
      {
        "id": "body",
        "domain": [
          "EvidenceItem",
          "FeedbackDraft"
        ],
        "datatype": "string",
        "meaning": "证据文本或反馈内容。",
        "required": true
      },
      {
        "id": "result",
        "domain": [
          "ApplicabilityAssessment"
        ],
        "datatype": "string",
        "meaning": "相对目标版本与策略的适用性结果。",
        "required": true,
        "allowedValues": [
          "applicable",
          "stale",
          "unknown"
        ]
      },
      {
        "id": "policy",
        "domain": [
          "ApplicabilityAssessment"
        ],
        "datatype": "string",
        "meaning": "使用的内容/路径/基线匹配规则。",
        "required": true
      },
      {
        "id": "evaluatedAt",
        "domain": [
          "ApplicabilityAssessment"
        ],
        "datatype": "datetime",
        "meaning": "评估发生时间。",
        "required": true
      }
    ],
    "constraints": [
      {
        "id": "O1",
        "kind": "identity",
        "statement": "相同内容不推出相同 Snapshot、ReviewActivity 或 Finding；相同路径不推出跨 worktree 同一文件。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O2",
        "kind": "dependency",
        "statement": "比较两侧观察必须同属比较的快照，side 分别为 base/current。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O3",
        "kind": "value",
        "statement": "absent 不等于 text(空串)，unavailable 不能作为内容相等的证明；缺失字段也不能当作 absent。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O4",
        "kind": "epistemic",
        "statement": "Finding 记录一次问题断言；schema 校验和 kind=issue 不蕴含命题为真，accepted 不蕴含修复完成。",
        "basis": "project-contract",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O5",
        "kind": "temporal",
        "statement": "适用性必须指明旧判断/断言、目标比较、策略和评估时间；历史断言不因新比较出现而被改写。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O6",
        "kind": "authority",
        "statement": "只有人工行为可产生 HumanJudgment；Agent 成功、Git 暂存、测试结果不蕴含 reviewed。",
        "basis": "project-contract",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O7",
        "kind": "coverage",
        "statement": "零意见只可相对于成功运行、有效报告和显式覆盖范围解释；不得推广到过滤、跳过或未提供的材料。",
        "basis": "project-contract",
        "sources": [
          "CONTEXT.md",
          "docs/CONTRACTS.md"
        ]
      },
      {
        "id": "O8",
        "kind": "workflow",
        "statement": "采纳产生 FeedbackDraft 的来源关系；保存草稿、正式判断、修复、Git 写入是不同事件。",
        "basis": "project-contract",
