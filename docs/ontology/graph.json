{
  "schemaVersion": 2,
  "modelVersion": "0.2-draft",
  "asOf": "2026-10-28",
  "scope": "Branchroom 的内容版本、审查行为、断言及适用性；含独立工程追溯层",
  "formalism": "显式类/实例、关系域值域、值属性及文字约束；未转换为 OWL，未进行逻辑完备性证明",
  "methodSources": [
    "https://protege.stanford.edu/publications/ontology_development/ontology101-noy-mcguinness.html",
    "https://www.w3.org/TR/owl-primer/"
  ],
  "ontology": {
    "categories": {
      "entity": "有持续身份的工作区、存储或行为主体",
      "event": "在时间中发生的行为",
      "information": "记录、比较、判断或断言的内容",
      "value": "按值解释的内容表示，不表示持续实体"
    },
    "classes": [
      {
        "id": "RepositoryStore",
        "label": "Git 共享存储",
        "category": "entity",
        "definition": "工作区引用的 Git 共享对象与引用存储。",
        "identity": "当前项目用 commonGitDir 识别本地共享存储；不声称跨机器身份稳定。",
        "basis": "modeling-proposal",
        "sources": [
          "src/main/services/repositories.ts"
        ]
      },
      {
        "id": "Worktree",
        "label": "仓库工作区",
        "category": "entity",
        "definition": "具有独立路径、HEAD、index 与工作区文件的本地 Git 工作区。",
        "identity": "工作区身份不等于共享存储身份；当前 repoId 按根路径派生，移动后连续性未解决。",
        "basis": "modeling-proposal",
        "sources": [
          "src/main/services/repositories.ts"
        ]
      },
      {
        "id": "Actor",
        "label": "行为承担者",
        "category": "entity",
        "definition": "在一次审查行为中承担责任的主体。",
        "identity": "不凭 provider 字符串认定同一个实际调用主体。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md"
        ]
      },
      {
        "id": "HumanReviewer",
        "label": "人工审查者",
        "category": "entity",
        "definition": "作出人工判断的人。",
        "identity": "示例用局部 ID；当前产品未持久化用户身份。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md"
        ],
        "subClassOf": "Actor"
      },
      {
        "id": "AgentInstallation",
        "label": "Agent 安装",
        "category": "entity",
        "definition": "可供调用的本地 CLI 安装，不等于模型、provider 品牌或一次运行。",
        "identity": "示例用局部安装 ID；实际 executable 和 version 仅为识别线索。",
        "basis": "modeling-proposal",
        "sources": [
          "src/main/agents/capabilities.ts"
        ],
        "subClassOf": "Actor"
      },
      {
        "id": "ReviewActivity",
        "label": "审查行为",
        "category": "event",
        "definition": "针对固定比较材料发生的审查过程。",
        "identity": "每次发生分别识别；同材料同主体再次审查也不是同一次行为。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md"
        ]
      },
      {
        "id": "HumanReviewActivity",
        "label": "人工审查行为",
        "category": "event",
        "definition": "人阅读材料并作出判断的事件。",
        "identity": "一次判断行为；当前保存记录不能重建完整行为历史。",
        "basis": "modeling-proposal",
        "sources": [
          "CONTEXT.md"
        ],
        "subClassOf": "ReviewActivity"
      },
      {
        "id": "AgentReviewRun",
        "label": "Agent 审查运行",
        "category": "event",
        "definition": "一次以固定快照选定比较为输入的 CLI 审查过程。",
        "identity": "runId 标识一次发生；重试创建新的 run。",
        "basis": "project-contract",
        "sources": [
          "src/main/services/review-runs.ts"
        ],
        "subClassOf": "ReviewActivity"
      },
      {
        "id": "Snapshot",
        "label": "快照记录",
        "category": "information",
        "definition": "记录特定工作区一次捕获的基线、时间与观察结果。",
        "identity": "snapshotId 标识捕获记录；内容相同的两次捕获仍可有不同 ID。",
        "basis": "project-contract",
        "sources": [
          "src/main/services/snapshots.ts"
        ]
      },
      {
        "id": "ContentValue",
        "label": "内容值",
        "category": "value",
        "definition": "带状态标记的文本内容值、缺席值或不可获得值。",
        "identity": "text 按文本相等；absent 与空文本不同；unavailable 不能证明内容相等。",
        "basis": "modeling-proposal",
        "sources": [
          "src/shared/contracts.ts",
          "src/main/services/snapshots.ts"
        ]
      },
      {
        "id": "FileObservation",
        "label": "文件观察记录",
        "category": "information",
        "definition": "某快照一侧对某路径的观察；观察可能是存在、缺席或不可读取。",
        "identity": "snapshot + side + path；不是跨时间文件实体，也不是磁盘 inode。",
        "basis": "modeling-proposal",
        "sources": [
          "src/main/services/snapshots.ts"
        ]
      },
      {
        "id": "ChangeComparison",
        "label": "变更比较记录",
        "category": "information",
        "definition": "同一快照内基线观察与当前观察的配对；是审查材料的核心单位。",
        "identity": "记录身份为 snapshotId + 当前 fileId；内容等价须另按策略比较。",
        "basis": "modeling-proposal",
        "sources": [
          "src/shared/contracts.ts",
          "src/main/services/snapshots.ts"
        ]
      },
      {
        "id": "HumanJudgment",
        "label": "人工判断内容",
        "category": "information",
        "definition": "人在一次审查中表达的 reviewed 或 issue 判断。",
        "identity": "语义上属于一次人工审查行为；当前 repoId + fileId 存储槽不等于完整判断历史。",
        "basis": "modeling-proposal",
        "sources": [
          "src/main/services/review-store.ts"
        ]
      },
      {
        "id": "AgentReport",
        "label": "Agent 报告",
        "category": "information",
        "definition": "一次运行产生的覆盖声明、局限与意见集合。",
        "identity": "属于一次 run；schema 有效不能证明其论断真实。",
        "basis": "project-contract",
        "sources": [
          "src/main/agents/report.ts"
        ]
      },
      {
        "id": "Finding",
        "label": "Agent 问题断言",
        "category": "information",
        "definition": "Agent 对比较材料提出的 issue 或 verify 断言。",
        "identity": "runId + finding.id；同文案不构成同一条断言。",
        "basis": "project-contract",
        "sources": [
          "src/shared/contracts.ts",
          "src/main/agents/report.ts"
        ]
      },
      {
        "id": "EvidenceItem",
        "label": "证据材料",
        "category": "information",
        "definition": "断言所引用的片段、外部资料或运行记录。",
        "identity": "证据出处与内容均需保留；引用存在不等于支持充分。",
        "basis": "modeling-proposal",
        "sources": [
          "src/shared/contracts.ts"
        ]
      },
      {
        "id": "FeedbackDraft",
        "label": "反馈草稿",
        "category": "information",
        "definition": "供人确认的修复反馈文本。",
        "identity": "草稿文档可修订；当前存储按 repoId + fileId 覆写，未提供版本历史。",
        "basis": "project-contract",
        "sources": [
          "src/main/services/review-store.ts",
          "src/renderer/features/agent-review/AgentPanel.tsx"
        ]
      },
      {
        "id": "ApplicabilityAssessment",
        "label": "适用性评估记录",
        "category": "information",
        "definition": "在特定时刻按特定策略，判断旧判断或断言能否直接用于目标比较。",
        "identity": "subject + targetComparison + policy + evaluatedAt；结论为 applicable / stale / unknown。",
        "basis": "modeling-proposal",
        "sources": [
          "src/main/services/review-store.ts",
          "src/renderer/features/agent-review/AgentPanel.tsx"
        ]
      }
    ],
    "objectProperties": [
      {
        "id": "usesStore",
        "domain": [
          "Worktree"
        ],
        "range": [
          "RepositoryStore"
        ],
        "min": 1,
        "max": 1,
        "meaning": "多个 worktree 可以共享同一存储，不能因此合并为同一工作区。"
      },
      {
        "id": "recordsWorktree",
        "domain": [
          "Snapshot"
        ],
        "range": [
          "Worktree"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "inSnapshot",
        "domain": [
          "FileObservation",
          "ChangeComparison"
        ],
        "range": [
          "Snapshot"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "observedContent",
        "domain": [
          "FileObservation"
        ],
        "range": [
          "ContentValue"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "baseObservation",
        "domain": [
          "ChangeComparison"
        ],
        "range": [
          "FileObservation"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "currentObservation",
        "domain": [
          "ChangeComparison"
        ],
        "range": [
          "FileObservation"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "performedBy",
        "domain": [
          "ReviewActivity"
        ],
        "range": [
          "Actor"
        ],
        "min": 1,
        "max": 1,
        "meaning": "主体未知时为知识缺口，不能从修改内容猜测。"
      },
      {
        "id": "examines",
        "domain": [
          "ReviewActivity"
        ],
        "range": [
          "ChangeComparison"
        ],
        "min": 1,
        "max": null,
        "meaning": ""
      },
      {
        "id": "yieldsJudgment",
        "domain": [
          "HumanReviewActivity"
        ],
        "range": [
          "HumanJudgment"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "judges",
        "domain": [
          "HumanJudgment"
        ],
        "range": [
          "ChangeComparison"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "producesReport",
        "domain": [
          "AgentReviewRun"
        ],
        "range": [
          "AgentReport"
        ],
        "min": 0,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "covers",
        "domain": [
          "AgentReport"
        ],
        "range": [
          "ChangeComparison"
        ],
        "min": 1,
        "max": null,
        "meaning": "报告声称完整审查且经结构校验的范围；不等于独立验证其实际理解。"
      },
      {
        "id": "assertedIn",
        "domain": [
          "Finding"
        ],
        "range": [
          "AgentReport"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "aboutComparison",
        "domain": [
          "Finding"
        ],
        "range": [
          "ChangeComparison"
        ],
        "min": 1,
        "max": 1,
        "meaning": ""
      },
      {
        "id": "cites",
        "domain": [
          "Finding"
        ],
        "range": [
          "EvidenceItem"
        ],
        "min": 0,
        "max": null,
        "meaning": "项目契约要求 evidence 文本；结构化证据实体是本体提案。"
      },
      {
        "id": "derivedFrom",
        "domain": [
          "FeedbackDraft"
        ],
        "range": [
