{
  "name": "branchroom",
  "version": "0.0.0",
  "private": true,
  "description": "Independent desktop Git client for reviewing agent-generated changes. Development preparation repository.",
  "author": "Branchroom contributors",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.11",
  "trustedDependencies": ["electron"],
  "engines": {
    "node": ">=22.22.0",
    "bun": ">=1.3.11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:mac": "bun run build && electron-builder --mac --dir",
    "check:prep": "bun scripts/check-prep.ts",
    "test:reference": "bun test reference/prototype/review-core.test.ts reference/prototype/agent-review.test.ts",
    "prototype:design": "bun scripts/preview-design.ts",
    "prototype:live": "bun reference/prototype/live-server.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
